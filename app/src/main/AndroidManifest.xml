<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <application
        android:name=".SketchpadApplication"
        android:allowBackup="true"
        android:appCategory="productivity"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sketchpad"
        android:largeHeap="true">
        <activity
            android:name=".library.LibraryActivity"
            android:exported="true"
            android:theme="@style/Theme.Sketchpad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".document.DocumentActivity"
            android:exported="true"
            android:label="@string/title_document"
            android:rotationAnimation="jumpcut"
            android:theme="@style/Theme.Sketchpad.Document" />
        <activity
            android:name=".brush.BrushEditorActivity"
            android:exported="false"
            android:label="@string/title_brush_editor"
            android:theme="@style/Theme.Sketchpad" />
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:icon="@drawable/settings_24px"
            android:label="@string/title_settings"
            android:theme="@style/Theme.Sketchpad" />
        <activity
            android:name=".settings.InputTestActivity"
            android:exported="false"
            android:label="@string/title_input_test"
            android:theme="@style/Theme.Sketchpad" />
    </application>

</manifest>